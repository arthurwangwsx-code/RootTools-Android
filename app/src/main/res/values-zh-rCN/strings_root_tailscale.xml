    <string name="root_tailscale_overlay_section">Root 私网</string>
    <string name="root_tailscale_overlay_section_desc">只把 tailnet 流量送进 tailscale0；普通互联网仍由 Android / Hiddify 管理。</string>
    <string name="root_tailscale_overlay_title">Root 管理的 Tailscale</string>
    <string name="root_tailscale_overlay_body">使用真实 Root TUN，而不是 Android VpnService；默认拒绝 Tailscale DNS 接管，避免和 Hiddify DNS 冲突。</string>
    <string name="root_tailscale_enable">启用 Root 私网</string>
    <string name="root_tailscale_disable">关闭 Root 私网</string>
    <string name="root_tailscale_repair">修复路由</string>
    <string name="root_tailscale_disable_confirm_title">关闭 Root Tailscale？</string>
    <string name="root_tailscale_disable_confirm_body">Root tailnet 地址和远程 ADB 路径会暂时消失，直到再次启用；认证状态会保留。</string>

    <string name="root_tailscale_auth_section">认证</string>
    <string name="root_tailscale_auth_section_desc">只需要做一次，身份状态保存在 Root 自有的 Tailscale state 文件中。</string>
    <string name="root_tailscale_auth_title">把这个 Root 节点加入 Tailnet</string>
    <string name="root_tailscale_auth_body">RootTools 先以 userspace 模式启动 tailscaled，获取官方认证地址并打开系统浏览器。Google / Microsoft / GitHub 密码不会进入 RootTools。</string>
    <string name="root_tailscale_auth_action">打开 Tailscale 认证</string>

    <string name="root_tailscale_coexistence_section">VPN 共存</string>
    <string name="root_tailscale_coexistence_section_desc">Android VpnService 留给 Hiddify 或其他代理；Tailscale 改走 Root Linux 网络层。</string>
    <string name="root_tailscale_coexistence_title">Android VPN 槽位</string>
    <string name="root_tailscale_coexistence_hiddify_ready">Hiddify 正在占用 Android VPN，同时 Root Tailscale 独立可用。这就是目标共存状态。</string>
    <string name="root_tailscale_coexistence_official_ready_to_release">Root Tailscale 已验证，可以安全停止官方 Tailscale Android VPN，释放系统 VPN 槽位。</string>
    <string name="root_tailscale_coexistence_official_blocking">官方 Tailscale Android App 仍占用 VPN。先完成 Root 节点认证并启用私网，再释放它。</string>
    <string name="root_tailscale_coexistence_slot_ready">Root Tailscale 已可用，Android VPN 槽位可以交给其他 VPN App。</string>
    <string name="root_tailscale_coexistence_waiting">先启用并验证 Root 私网，再进入双 VPN 共存状态。</string>
    <string name="root_tailscale_stop_official_app">释放官方 Tailscale VPN 槽位</string>

    <string name="root_tailscale_runtime_section">Runtime</string>
    <string name="root_tailscale_runtime_section_desc">特权网络 Runtime 固定版本并校验哈希，不直接下载未经验证的 latest。</string>
    <string name="root_tailscale_runtime_title">已验证 Tailscale %1$s ARM64</string>
    <string name="root_tailscale_runtime_body">从官方 stable 地址下载，严格校验固定 SHA-256，只解包 tailscale/tailscaled，再原子安装到 /data/adb/tailscale。</string>
    <string name="root_tailscale_runtime_install">安装已验证 Runtime</string>
    <string name="root_tailscale_runtime_update">重新安装 / 更新已验证 Runtime</string>

    <string name="root_tailscale_boot_section">开机恢复</string>
    <string name="root_tailscale_boot_section_desc">默认关闭；开启后也不会安装无限重试循环。</string>
    <string name="root_tailscale_boot_title">开机恢复 Root Tailscale</string>
    <string name="root_tailscale_boot_body">只安装一个 RootTools 自有的 Magisk service.d 脚本。它会有限等待 tailscale0，并且只有 Root 私网拿到合法地址后才停止官方 Tailscale App。</string>
    <string name="root_tailscale_boot_confirm_title">启用开机恢复？</string>
    <string name="root_tailscale_boot_confirm_body">将写入 /data/adb/service.d/99-roottools-tailscale.sh；可通过同一开关完整删除，不修改其他 Magisk 启动脚本。</string>
    <string name="root_tailscale_boot_disable_confirm_title">关闭开机恢复？</string>
    <string name="root_tailscale_boot_disable_confirm_body">只会删除 RootTools 自己的 Root Tailscale service.d 脚本；当前正在运行的私网不会因此停止。</string>
    <string name="root_tailscale_confirm">确认</string>

